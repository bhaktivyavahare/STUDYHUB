# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000

# ─── Supabase PostgreSQL (Database only) ───────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ─── Cloudinary Storage ────────────────────────────────────────────────────
# Files (PDFs, DOCx, PPTx) are stored in Cloudinary instead of a local folder.
#
# How to get credentials:
#   1. Sign up / log in at https://cloudinary.com
#   2. Open the Dashboard — you'll see Cloud name, API Key, API Secret
#   3. Copy those three values here.
#
# WARNING: Keep CLOUDINARY_API_SECRET private. Never commit to git. Never expose to frontend.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: root folder name inside your Cloudinary media library (default: studyhub-resources)
# CLOUDINARY_FOLDER=studyhub-resources

# ─── Authentication ────────────────────────────────────────────────────────
# Generate a strong random string (32+ chars). Never hardcode in source code.
JWT_SECRET=replace-with-a-long-random-secret

# ─── CORS ──────────────────────────────────────────────────────────────────
# Production: your deployed frontend URL (e.g. Vercel domain)
# Dev: http://localhost:5173 is used automatically if this is not set
# Multiple origins: comma-separated — "https://studyhub.vercel.app,https://www.studyhub.com"
FRONTEND_URL=https://your-frontend.vercel.app
