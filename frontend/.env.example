# ─── API Base URL ──────────────────────────────────────────────────────────
# Development: leave blank — Vite dev server proxies /api → localhost:5000
#
# Production (Netlify): set this to your Render backend URL.
# Pattern:  https://<your-render-service-name>.onrender.com/api
# Example:  VITE_API_URL=https://studyhub-api.onrender.com/api
#
# Set this in the Netlify Dashboard:
#   Site → Site configuration → Environment variables → Add variable
#   Key:   VITE_API_URL
#   Value: https://studyhub-api.onrender.com/api
VITE_API_URL=
